<section class="hero">
  <p class="eyebrow">One Book Leads to Another</p>
  <h1>Booktrail</h1>
  <p class="lead"><%= t('home.lead') %></p>
  <p class="jp-lead"><%= t('home.local_lead') %></p>
  <div class="actions"><%= link_to t('home.import'), new_import_path, class: 'button' %><% if @record_count.positive? %><%= link_to t('home.find_books'), new_recommendation_session_path, class: 'text-link' %><% end %></div>
</section>
<section class="principle"><p>“<%= sanitize(t('home.principle'), tags: %w[br]) %>”</p></section>
<section class="three-up">
  <% %w[history goal reason].each_with_index do |step, index| %><article><span><%= format('%02d', index + 1) %></span><h2><%= t("home.steps.#{step}.title") %></h2><p><%= t("home.steps.#{step}.body") %></p></article><% end %>
</section>
