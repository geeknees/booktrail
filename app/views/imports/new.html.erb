<section class="page-heading"><p class="eyebrow"><%= t('imports.new.eyebrow') %></p><h1><%= t('imports.new.title') %></h1><p><%= t('imports.new.description') %></p></section>
<%= form_with url: imports_path, scope: :import, class: 'upload-panel' do |form| %>
  <%= form.file_field :file, accept: '.csv,text/csv', required: true %>
  <p><%= t('imports.new.requirements') %></p>
  <%= form.submit t('imports.new.submit'), class: 'button' %>
<% end %>
<aside class="note"><h2><%= t('imports.new.fields_title') %></h2><p><%= t('imports.new.fields') %></p></aside>
