<section class="page-heading"><p class="eyebrow"><%= t('imports.show.eyebrow') %></p><h1><%= t('imports.show.title') %></h1><p><%= @import.original_filename %></p></section>
<div class="stats">
  <% %w[success skipped errors].each do |key| %><div class="stat"><strong><%= @import.result[key] || 0 %></strong><span><%= t("imports.show.#{key}") %></span></div><% end %>
</div>
<% if @import.result['row_errors'].present? %><div class="note"><h2><%= t('imports.show.row_errors') %></h2><ul><% @import.result['row_errors'].each do |error| %><li><%= t('imports.show.row', line: error['line'], message: error['message']) %></li><% end %></ul></div><% end %>
<div class="actions"><%= link_to t('imports.show.profile'), reading_profile_path, class: 'button' %><%= link_to t('imports.show.another'), new_import_path, class: 'text-link' %></div>
