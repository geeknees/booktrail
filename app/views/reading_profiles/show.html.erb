<section class="page-heading"><p class="eyebrow"><%= t('profiles.eyebrow') %></p><h1><%= t('profiles.title') %></h1><p><%= t('profiles.description') %></p></section>
<section class="profile-card"><h2><%= t('profiles.outline') %></h2><p class="profile-summary"><%= @profile.summary %></p>
  <div class="profile-grid"><div><h3><%= t('profiles.topics') %></h3><p><%= @profile.favorite_topics.join(' · ').presence || t('profiles.add_history') %></p></div><div><h3><%= t('profiles.authors') %></h3><p><%= @profile.favorite_authors.join(' · ').presence || t('profiles.unknown') %></p></div><div><h3><%= t('profiles.readability') %></h3><p><%= @profile.typical_page_count ? t('profiles.average_pages', count: @profile.typical_page_count) : t('profiles.unknown') %></p></div></div>
</section>
<div class="actions"><%= link_to t('profiles.choose_goal'), new_recommendation_session_path, class: 'button' %><%= button_to t('profiles.delete'), reading_history_path, method: :delete, class: 'danger-link', form: { data: { turbo_confirm: t('profiles.confirm_delete') } } %></div>
