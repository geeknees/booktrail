<section class="page-heading"><p class="eyebrow"><%= t('comparison.eyebrow') %></p><h1><%= t('comparison.title') %></h1><p><%= t('comparison.question') %></p></section>
<div class="comparison-table"><table><thead><tr><th><%= t('comparison.category') %></th><% Recommendation::ALGORITHMS.each do |algorithm| %><th><%= t("comparison.#{algorithm}") %></th><% end %></tr></thead><tbody>
  <% Recommendation::CATEGORIES.each do |category| %><tr><th><%= t("recommendations.categories.#{category}.title") %></th><% Recommendation::ALGORITHMS.each do |algorithm| %><td><% item = @recommendations.fetch(algorithm, []).find { |rec| rec.category == category } %><% if item %><strong><%= item.book.title %></strong><small><%= item.book.author %></small><%= link_to t('comparison.details'), recommendation_path(item) %><% else %><%= t('comparison.no_candidate') %><% end %></td><% end %></tr><% end %>
</tbody></table></div>
<div class="actions"><%= link_to t('comparison.back'), recommendation_session_path(@session), class: 'button' %></div>
