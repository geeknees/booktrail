<section class="page-heading"><p class="eyebrow"><%= t('goals.page.eyebrow') %></p><h1><%= t('goals.page.title') %></h1><p><%= t('goals.page.description') %></p></section>
<%= form_with url: recommendation_sessions_path, scope: :recommendation_session, class: 'goal-grid' do |form| %>
  <% RecommendationSession::GOALS.each do |goal| %>
    <label class="goal-card"><%= form.radio_button :reading_goal, goal, required: true %><span><strong><%= t("goals.#{goal}.title") %></strong><small><%= t("goals.#{goal}.description") %></small></span></label>
  <% end %>
  <%= form.submit t('goals.page.submit'), class: 'button goal-submit' %>
<% end %>
