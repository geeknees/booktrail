<% unless @session.completed? || @session.failed? %><% content_for :head do %><meta http-equiv="refresh" content="3"><% end %><% end %>
<% if @session.pending? || @session.processing? %>
  <section class="page-heading generation-status"><p class="eyebrow"><%= t('recommendations.pending.eyebrow') %></p><h1><%= t('recommendations.pending.title') %></h1><p><%= t('recommendations.pending.description') %></p><span class="loading-mark" aria-hidden="true"></span></section>
<% elsif @session.failed? %>
  <section class="page-heading generation-status"><p class="eyebrow"><%= t('recommendations.failed.eyebrow') %></p><h1><%= t('recommendations.failed.title') %></h1><p><%= @session.error_message %></p><div class="actions"><%= link_to t('recommendations.failed.retry'), new_recommendation_session_path, class: 'button' %></div></section>
<% else %>
<section class="page-heading"><p class="eyebrow"><%= t('recommendations.result.eyebrow') %></p><h1><%= t('recommendations.result.title') %></h1><p><%= t('recommendations.result.description') %></p></section>
<div class="recommendations">
  <% @recommendations.each do |recommendation| %><article class="recommendation-card">
    <div class="book-cover"><% if recommendation.book.cover_image_url.present? %><%= image_tag recommendation.book.cover_image_url, alt: recommendation.book.title %><% else %><span>Booktrail</span><% end %></div>
    <div class="book-copy"><p class="category"><%= t("recommendations.categories.#{recommendation.category}.title") %><small><%= t("recommendations.categories.#{recommendation.category}.subtitle") %></small></p><h2><%= recommendation.book.title %></h2><p class="author"><%= recommendation.book.author %></p><p><%= truncate(recommendation.book.description, length: 110) %></p><div class="reason"><strong><%= t('recommendations.result.reason') %></strong><p><%= recommendation.explanation %></p></div>
      <div class="feedbacks"><% RecommendationFeedback::TYPES.each do |feedback_type| %><%= button_to t("recommendations.feedback.#{feedback_type}"), recommendation_feedbacks_path, params: { recommendation_feedback: { recommendation_id: recommendation.id, feedback_type: feedback_type } }, class: 'feedback-button' %><% end %></div>
    </div></article><% end %>
</div>
<div class="actions"><%= link_to t('recommendations.result.compare'), recommendation_session_comparison_path(@session), class: 'text-link' %></div>
<% end %>
