<section class="page-heading"><p class="eyebrow"><%= t('developer.eyebrow') %></p><h1><%= t('developer.title', title: @recommendation.book.title) %></h1><p><%= t('developer.description') %></p></section>
<% fields = [['algorithm', @recommendation.algorithm], ['backend', @recommendation.score_details['backend']], ['original_rank', @recommendation.score_details['original_rank']], ['final_rank', @recommendation.score_details['final_rank']], ['BM25', @recommendation.score_details['bm25_score']], ['Vector', @recommendation.score_details['vector_score']], ['RRF', @recommendation.score_details['rrf_score']], ['Reranker', @recommendation.score_details['reranker_score']], ['reading_pattern_fit', @recommendation.score_details['reading_pattern_fit']], ['goal_fit', @recommendation.score_details['reading_goal_fit']], ['novelty', @recommendation.score_details['novelty']], ['diversity', @recommendation.score_details['diversity']], ['feedback_fit', @recommendation.score_details['feedback_fit']], ['final_score', @recommendation.score_details['final_score']], ['query_expansion', Array(@recommendation.score_details['query_expansion']).join(' / ').presence]] %>
<dl class="score-list"><% fields.each do |key, value| %><dt><%= %w[BM25 Vector RRF Reranker].include?(key) ? key : t("developer.fields.#{key}") %></dt><dd><%= value.presence || '—' %></dd><% end %></dl>
